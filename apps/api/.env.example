# API Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Get from Supabase dashboard → Settings → Database → Connection string (Transaction Pooler)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"

# ─── REDIS ────────────────────────────────────────────────────────────────────
# Get from Upstash console → Redis → Connect → Node.js (ioredis)
REDIS_URL="rediss://default:[PASSWORD]@[HOST].upstash.io:6380"

# ─── JWT SECRETS ──────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="REPLACE_WITH_RANDOM_64_BYTE_HEX"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_64_BYTE_HEX"

# Token expiry
JWT_ACCESS_EXPIRY_SECONDS=900        # 15 minutes
JWT_REFRESH_EXPIRY_DAYS=30

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ─── FILE STORAGE (local disk for dev) ───────────────────────────────────────
STORAGE_DRIVER="local"               # "local" | "s3"
LOCAL_UPLOAD_DIR="./uploads"         # Only used when STORAGE_DRIVER=local

# Production S3/R2 settings (fill in when deploying)
# S3_BUCKET_NAME=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT_URL=""                 # For Cloudflare R2: https://[ACCOUNT_ID].r2.cloudflarestorage.com

# ─── EMAIL ────────────────────────────────────────────────────────────────────
# For dev: use a test service like Mailtrap (https://mailtrap.io)
EMAIL_FROM="noreply@ricetrace.pk"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your_mailtrap_user"
SMTP_PASS="your_mailtrap_pass"

# ─── APP URLs ─────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"       # Frontend URL — used in magic link emails
API_URL="http://localhost:4000"

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000           # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10                # Stricter limit for auth endpoints

# ─── BCRYPT ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
