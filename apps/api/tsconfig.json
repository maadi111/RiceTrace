{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "paths": {
      "@ricetrace/db": ["../../packages/db/src/index.ts"],
      "@ricetrace/types": ["../../packages/types/src/index.ts"],
      "@ricetrace/validators": ["../../packages/validators/src/index.ts"],
      "@ricetrace/pdf-templates": ["../../packages/pdf-templates/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
